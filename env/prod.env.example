# PROD profile — topology: Multi-AZ primary + read replica.
export DR_ENV=prod
export AWS_REGION=eu-west-1
export REPLICA_REGION=eu-west-1              # set to another region if the replica is cross-region (recommended, see docs/08)
export ACCOUNT_ID=111122223333
export PRIMARY_DB=app-pg-prod
export REPLICA_DB=app-pg-prod-replica
export MULTI_AZ=true
export DB_NAME=app
export APP_DB_USER=app_user
export SECRET_ID=prod/app/db
export SECRET_ID_RO=prod/app/db-ro
export EKS_CONTEXT=eks-prod
export K8S_NS=app
export K8S_SECRET=db-creds
export DR_SELECTOR='dr.example.com/db-consumer=true'
export QUARANTINE_SG=sg-0dddddddddddddddd
export DB_SUBNET_GROUP=app-prod-db-subnets
export DB_SG=sg-0aaaaaaaaaaaaaaa3
export DB_PARAM_GROUP=app-pg16-prod
export DB_INSTANCE_CLASS=db.r6g.2xlarge
export MASTER_SECRET_ID=prod/app/db-master       # master user secret (fencing F1, password fix after restore)
export K8S_SECRET_RO=db-creds-ro
export EXTRA_TAGS="Key=backup-plan,Value=prod-daily"   # tags restored instances need (e.g. AWS Backup plan selection)
export APP_HEALTH_URLS="https://app.prod.example.internal/healthz/deep"
export EVIDENCE_BUCKET=org-dr-evidence-${ACCOUNT_ID}
export RTO_TARGET_MIN=60 RPO_TARGET_S=300
