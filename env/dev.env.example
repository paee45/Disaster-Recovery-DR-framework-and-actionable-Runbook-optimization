# Single source of truth for ALL runbook/script variables (TICKET-103). Validate with: automation/scripts/dr-env-check.sh
# DEV profile — copy to env/dev.env (git-ignored) and adjust. Topology: single primary, no Multi-AZ, no replica.
export DR_ENV=dev
# ── Identity pinning (guardrails): every aws/kubectl call uses ONLY these ──
export AWS_PROFILE=dr-dev                    # named profile (SSO or role_arn+MFA) in ~/.aws/config; no default profile
export KUBECONFIG="$HOME/.kube/dr-dev.config" # separate kubeconfig per env → another env's cluster cannot be reached by accident
export EKS_CLUSTER_NAME=eks-dev               # dr_guard checks the context's API server == this cluster's endpoint in ACCOUNT_ID
export AWS_ROLE_PATTERN='assumed-role/(DRExecutorRole|AWSReservedSSO_DRExecutor)'   # optional: caller must be the DR role
export DR_AUTH_ALLOWED=sso,role,key          # credential types the profile may use: sso | role | process | key. SSO preferred; a static key in a NAMED profile is accepted for DEV
                                              # key = aws_access_key_id in ~/.aws/credentials under [<AWS_PROFILE>] (never exported, never [default]).
                                              # With a key, AWS_ROLE_PATTERN for a user looks like 'user/<your-iam-user>'.
#export DR_AUTO_SSO_LOGIN=1                   # SSO expired: open the browser without asking (the script waits and continues)
#export DR_SSO_NO_BROWSER=1                   # over SSH/remote: print the login URL + code instead of opening a browser
export REQUIRE_CLUSTER_IDENTITY=true          # kube-system/dr-cluster-identity must say env=dev, account=ACCOUNT_ID
export AWS_REGION=eu-west-1
export ACCOUNT_ID=111122223333
export PRIMARY_DB=app-pg-dev                 # current primary instance identifier
export REPLICA_DB=                           # none in DEV
export MULTI_AZ=false                 # false = follow the source baseline
export DB_NAME=app
export APP_DB_USER=app_user
export SECRET_ID=dev/app/db                  # Secrets Manager secret holding host/port/username/password/dbname
export SECRET_ID_RO=                         # read-only secret (none in DEV)
export EKS_CONTEXT=dr-dev                    # alias created by: aws eks update-kubeconfig --name eks-dev --alias dr-dev --kubeconfig "$KUBECONFIG" --profile dr-dev
export K8S_NS=app
export SECRET_MODE=k8s                       # k8s = patch the K8s Secret directly + ledger (simple, now) · eso = Secrets Manager → ESO (to-do)
export K8S_SECRET=db-creds                   # the K8s Secret the apps read (e.g. <app>-db-credentials)
export K8S_HOST_KEY=POSTGRES_DB_HOST1,POSTGRES_DB_HOST2   # ALL keys holding the DB host — each gets the same new endpoint
export K8S_PORT_KEY=POSTGRES_DB_PORT          # optional: key holding the port (updated + recorded too)
export K8S_USER_KEY=POSTGRES_DB_USER K8S_PASSWORD_KEY=POSTGRES_DB_PASSWORD   # k8s mode: app credentials for precheck/fix-password
export DR_TICKET=""                          # optional incident/change ticket, stored in every ledger entry
export DR_SELECTOR='dr.example.com/db-consumer=true'
export QUARANTINE_SG=sg-0dddddddddddddddd    # SG with NO inbound rules, used to fence an instance
export DB_SUBNET_GROUP=""                 # empty = take it from the source baseline (non-empty = explicit override, reported by validate; e.g. app-dev-db-subnets)
export DB_SG=""                 # empty = take it from the source baseline (non-empty = explicit override, reported by validate; e.g. sg-0aaaaaaaaaaaaaaa1)
export DB_PARAM_GROUP=""                 # empty = take it from the source baseline (non-empty = explicit override, reported by validate; e.g. app-pg16-dev)
export DB_INSTANCE_CLASS=""                 # empty = take it from the source baseline (non-empty = explicit override, reported by validate; e.g. db.t4g.medium)
export MASTER_SECRET_ID=dev/app/db-master       # master user secret (fencing F1, password fix after restore)
export K8S_SECRET_RO=
export K8S_HOST_KEY_RO=              # k8s mode, read-only Secret: its host key(s), comma list (empty = same as K8S_HOST_KEY); used with CUTOVER_SECRET=ro
export EXTRA_TAGS="Key=backup-plan,Value=dev-daily"   # tags restored instances need (e.g. AWS Backup plan selection)
export VERIFY_TABLES=""                    # e.g. "public.orders public.transactions" — used by dr-verify.sh compare-counts
export APP_HEALTH_URLS="https://app.dev.example.internal/healthz/deep"
export EVIDENCE_BUCKET=org-dr-evidence-${ACCOUNT_ID}
export RTO_TARGET_MIN=30 RPO_TARGET_S=86400     # RTO 30 min (aim) · RPO 24 h (RDS daily backup, 7-day retention)
export REPLICA_LAG_MAX_S=300                    # operational replica-lag threshold for S2 pre-flight (not the RPO)
export BACKUP_RETENTION_DAYS=7                  # MINIMUM retention for restored instances (baseline value wins if higher; CLI default would be 1)
export BASELINE_DIR=""                          # empty = evidence/baselines/<env>; restore settings are captured from the source here
export BASELINE_S3_URI="s3://${EVIDENCE_BUCKET}/baselines/dev"   # scheduled `dr-restore.sh capture` uploads here; used if the source is gone
