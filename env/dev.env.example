# DEV profile — copy to env/dev.env (git-ignored) and adjust. Topology: single primary, no Multi-AZ, no replica.
export DR_ENV=dev
export AWS_REGION=eu-west-1
export ACCOUNT_ID=111122223333
export PRIMARY_DB=app-pg-dev                 # current primary instance identifier
export REPLICA_DB=                           # none in DEV
export MULTI_AZ=false
export DB_NAME=app
export APP_DB_USER=app_user
export SECRET_ID=dev/app/db                  # Secrets Manager secret holding host/port/username/password/dbname
export SECRET_ID_RO=                         # read-only secret (none in DEV)
export EKS_CONTEXT=eks-dev
export K8S_NS=app
export K8S_SECRET=db-creds                   # K8s Secret created by the ExternalSecret of the same name
export DR_SELECTOR='dr.example.com/db-consumer=true'
export QUARANTINE_SG=sg-0dddddddddddddddd    # SG with NO inbound rules, used to fence an instance
export DB_SUBNET_GROUP=app-dev-db-subnets
export DB_SG=sg-0aaaaaaaaaaaaaaa1
export DB_PARAM_GROUP=app-pg16-dev
export DB_INSTANCE_CLASS=db.t4g.medium
export MASTER_SECRET_ID=dev/app/db-master       # master user secret (fencing F1, password fix after restore)
export K8S_SECRET_RO=
export EXTRA_TAGS="Key=backup-plan,Value=dev-daily"   # tags restored instances need (e.g. AWS Backup plan selection)
export APP_HEALTH_URLS="https://app.dev.example.internal/healthz/deep"
export EVIDENCE_BUCKET=org-dr-evidence-${ACCOUNT_ID}
export RTO_TARGET_MIN=480 RPO_TARGET_S=86400
