# Single source of truth for ALL runbook/script variables (TICKET-103). Validate with: automation/scripts/dr-env-check.sh
# UAT profile — topology: single-AZ primary + read replica (no Multi-AZ).
export DR_ENV=uat
export AWS_REGION=eu-west-1
export REPLICA_REGION=eu-west-1              # set to another region if the replica is cross-region
export ACCOUNT_ID=111122223333
export PRIMARY_DB=app-pg-uat
export REPLICA_DB=app-pg-uat-replica
export MULTI_AZ=false
export DB_NAME=app
export APP_DB_USER=app_user
export SECRET_ID=uat/app/db
export SECRET_ID_RO=uat/app/db-ro            # if apps send reads to the replica; empty otherwise
export EKS_CONTEXT=eks-uat
export K8S_NS=app
export K8S_SECRET=db-creds                   # K8s Secret synced by ESO (e.g. <app>-db-credentials)
export K8S_HOST_KEY=DB_HOST                  # key in that Secret holding the host (e.g. POSTGRES_DB_HOST)
export DR_SELECTOR='dr.example.com/db-consumer=true'
export QUARANTINE_SG=sg-0dddddddddddddddd
export DB_SUBNET_GROUP=""                 # empty = copy from the source instance at restore time (fallback value: app-uat-db-subnets)
export DB_SG=""                 # empty = copy from the source instance at restore time (fallback value: sg-0aaaaaaaaaaaaaaa2)
export DB_PARAM_GROUP=""                 # empty = copy from the source instance at restore time (fallback value: app-pg16-uat)
export DB_INSTANCE_CLASS=""                 # empty = copy from the source instance at restore time (fallback value: db.r6g.large)
export MASTER_SECRET_ID=uat/app/db-master       # master user secret (fencing F1, password fix after restore)
export K8S_SECRET_RO=db-creds-ro
export EXTRA_TAGS="Key=backup-plan,Value=uat-daily"   # tags restored instances need (e.g. AWS Backup plan selection)
export VERIFY_TABLES=""                    # e.g. "public.orders public.transactions" — used by dr-verify.sh compare-counts
export APP_HEALTH_URLS="https://app.uat.example.internal/healthz/deep"
export EVIDENCE_BUCKET=org-dr-evidence-${ACCOUNT_ID}
export RTO_TARGET_MIN=30 RPO_TARGET_S=86400     # RTO 30 min (aim) · RPO 24 h (RDS daily backup, 7-day retention)
export REPLICA_LAG_MAX_S=300                    # operational replica-lag threshold for S2 pre-flight (not the RPO)
export BACKUP_RETENTION_DAYS=7
