# cp sandbox.env.example sandbox.env   (git-ignored; holds the account id)  — read by iac/tf.sh
# Bucket name = output "bucket" of iac/platform/state-bucket: <prefix>-tfstate-<account_id>-<region>
export TF_VAR_account_id=000000000000
export TF_VAR_aws_profile=lab_sandbox
# Optional: which login kinds tf.sh accepts (sso, role, process, key). Default: all. A real PROD account: sso,role
#export TF_AUTH_ALLOWED=sso,role
export TF_VAR_region=ap-southeast-1
# SSH host must match ENV: dev-1.app.beepte.ch or uat-1.app.beepte.ch; prod is refused.
export BB3_DEPLOYMENT_HOST=uat-1.app.beepte.ch
# Docker Swarm stack verified by P3-S03.
export BB3_DOCKER_STACK_NAME=beepbeep
# BB3 restore includes primary and replica: default 60 minutes; set 45 or 30 if required.
export BB3_RTO_TARGET_MIN=60
# Display label used by the isolated Docker deployment mock; it does not target a real EC2 instance.
export BB3_DEPLOYMENT_CONTAINER=bb3-deploument-ec2
# Blank selects real SSH to BB3_DEPLOYMENT_HOST; set a local Docker context only to run the mock.
export BB3_DOCKER_LOCAL_CONTEXT=
export TF_VAR_state_bucket=dr-tfstate-000000000000-ap-southeast-1
# Only for platform/terrakube-config: API token from the Terrakube UI (user menu > Tokens); needs the SSM tunnel open.
#export TF_VAR_terrakube_token=
