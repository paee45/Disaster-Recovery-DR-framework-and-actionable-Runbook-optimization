variable "direct_only" {
  description = "Two-app direct-Secret walkthrough; false retains the complete regression fixture."
  type        = bool
  default     = true
}

variable "config_path" {
  description = "Dedicated kubeconfig generated by the parent helper; apply addons before planning this stage."
  type        = string
  default     = "/workspace/tests/local/.state/kubeconfig"
  nullable    = false

  validation {
    condition     = var.config_path == "/workspace/tests/local/.state/kubeconfig"
    error_message = "Run inside the isolated /workspace tools runner with its dedicated .state/kubeconfig; personal kubeconfigs are not allowed."
  }

  validation {
    condition = try(
      one([
        for cluster in yamldecode(file(var.config_path)).clusters : cluster.cluster.server
        if cluster.name == one([
          for context in yamldecode(file(var.config_path)).contexts : context.context.cluster
          if context.name == "dr-local"
        ])
      ]) == "https://localhost:6443",
      false
    )
    error_message = "The generated kubeconfig must exist, contain exactly one dr-local context, and resolve that context to https://localhost:6443."
  }
}