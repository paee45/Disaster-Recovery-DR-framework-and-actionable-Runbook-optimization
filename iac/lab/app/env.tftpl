# GENERATED by iac/lab/app (iac/tf.sh lab/app ${env} apply) for the DR LAB in the sandbox account — do not edit by hand;
# change iac/lab and re-apply. Git-ignored. No passwords in here (RDS master: Secrets Manager; app: the K8s Secret).
export DR_ENV=${env}
export DR_LAB=1
# ── Identity pinning (guardrails): every aws/kubectl call uses ONLY these ──
export AWS_PROFILE=${aws_profile}
export KUBECONFIG="${kubeconfig}"
export EKS_CLUSTER_NAME=${cluster}
export AWS_ROLE_PATTERN='${env == "prod" ? "assumed-role/" : "assumed-role/|:user/"}'   # SSO/role session, or an IAM user key (not prod)
export DR_AUTH_ALLOWED=${env == "prod" ? "sso,role" : "sso,role,key"}   # key = a static key in a NAMED profile (never exported)
export DR_ALLOW_DEFAULT_PROFILE=1   # this Mac has a [default] AWS profile; strict pinning still forces --profile on every call
export REQUIRE_CLUSTER_IDENTITY=${require_identity}   # the shared lab cluster identifies as one env only (lab/addons identity_env)
export AWS_REGION=${region}
export REPLICA_REGION=${region}
export ACCOUNT_ID=${account_id}
export PRIMARY_DB=${db}
export REPLICA_DB=""
export MULTI_AZ=${multi_az}
export DB_NAME=app
export APP_DB_USER=app_user
export SECRET_ID=""
export SECRET_ID_RO=""
export EKS_CONTEXT=${context}
export K8S_NS=${namespace}
export SECRET_MODE=k8s
export K8S_SECRET=${secret}
export K8S_HOST_KEY=POSTGRES_DB_HOST1,POSTGRES_DB_HOST2
export K8S_PORT_KEY=POSTGRES_DB_PORT
export K8S_USER_KEY=POSTGRES_DB_USER K8S_PASSWORD_KEY=POSTGRES_DB_PASSWORD
export K8S_SECRET_RO="" K8S_HOST_KEY_RO=""
export PRIMARY_STOPPED_OK=0
export DR_TICKET="LAB"
export DR_SELECTOR='dr.example.com/db-consumer=true'
export QUARANTINE_SG=${quarantine_sg}
export DB_SUBNET_GROUP="" DB_SG="" DB_PARAM_GROUP="" DB_INSTANCE_CLASS=""
export MASTER_SECRET_ID=${master_secret}
export EXTRA_TAGS="Key=dr-lab,Value=true"
export VERIFY_TABLES="public.orders public.payments"
export APP_HEALTH_URLS=""
export EVIDENCE_BUCKET=${bucket}
export RTO_TARGET_MIN=30 RPO_TARGET_S=86400
export REPLICA_LAG_MAX_S=300
export BACKUP_RETENTION_DAYS=7
export BASELINE_DIR=""
export BASELINE_S3_URI="s3://${bucket}/baselines/${env}"
export SNAPSHOT_ID=${snapshot}   # seeded manual snapshot (the automated one predates the seed)
