# copy to terraform.tfvars (git-ignored) and fill in
account_id    = "123456789012"   # the SANDBOX account (Terraform refuses any other)
aws_profile   = "pa_sandbox"     # SSO profile for that account
region        = "ap-southeast-1"
operator_cidr = "203.0.113.10/32" # your public IP: curl -s https://checkip.amazonaws.com
# db_instance_class    = "db.t4g.micro"  # free tier; "" = the fixture's class (UAT: db.t4g.small)
# performance_insights = false
# node_instance_type   = "t3.small"
